---
import { SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="wrap">
  <p>© {year} {SITE.author}</p>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    margin-top: 5rem;
    padding-top: 1rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--faint);
  }

  footer p {
    margin: 0;
  }

  footer a {
    color: inherit;
  }
</style>
